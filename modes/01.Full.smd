Name = Full
NAME_LOCALE{"PL-PL", "Pełny"}
NAME_LOCALE{"DE-DE", "Voll"}
NAME_LOCALE{"RU-RU", "Полный"}
VERSION = 1

User_RefreshRate = 1
;;User_RefreshRate_Description = Max refresh rate of rendered overlay. It won't be faster than your current display refresh rate because of vsync.
;;User_RefreshRate_Description_PL-PL = Maksymalna częstotliwość odświeżania nakładki. Przez vsync nie będzie szybsza niż odświeżanie ekranu.
;;User_RefreshRate_Description_DE-DE = Maximale Aktualisierungsrate des Overlays. Aufgrund von VSync kann es nicht höher als die aktuelle Bildwiederholrate sein.
;;User_RefreshRate_Description_RU-RU = Максимальная частота обновления оверлея. Из-за vsync не будет выше текущей частоты обновления экрана.
;;User_RefreshRate_Name = Refresh rate
;;User_RefreshRate_Name_PL-PL = Odświeżanie
;;User_RefreshRate_Name_DE-DE = Aktualisierungsrate
;;User_RefreshRate_Name_RU-RU = Частота обновления

;;User_RefreshRate_DefaultValue = 1
;;User_RefreshRate_Range = {int, 1, 60}
User_ShowRealFrequencies = true
;;User_ShowRealFrequencies_Description = Show real frequencies for CPU, GPU and RAM. Shows up only when hoc-clk or sys-clk is detected running.
;;User_ShowRealFrequencies_Description_PL-PL = Pokaż rzeczywiste taktowania CPU, GPU\ni RAM. Dostępne tylko gdy działa w tle hoc-clk albo sys-clk.
;;User_ShowRealFrequencies_Description_DE-DE = Zeigt tatsächliche Frequenzen für CPU, GPU und RAM an. Wird nur angezeigt, wenn hoc-clk oder sys-clk erkannt werden.
;;User_ShowRealFrequencies_Description_RU-RU = Показывать реальные частоты CPU, GPU и RAM. Отображается только при запущенном hoc-clk или sys-clk.
;;User_ShowRealFrequencies_Name = Show real frequencies
;;User_ShowRealFrequencies_Name_PL-PL = Pokaż rzeczywiste częstotliwości
;;User_ShowRealFrequencies_Name_DE-DE = Echte Frequenzen anzeigen
;;User_ShowRealFrequencies_Name_RU-RU = Показывать реальные частоты

;;User_ShowRealFrequencies_DefaultValue = true
User_ShowClock = true
;;User_ShowClock_Description = Show current time and battery charge in the top right corner.
;;User_ShowClock_Description_RU-RU = Показывать текущее время и заряд батареи в правом верхнем углу.
;;User_ShowClock_Name = Show clock and battery
;;User_ShowClock_Name_RU-RU = Часы и батарея
;;User_ShowClock_DefaultValue = true
User_UseTheme = true
;;User_UseTheme_Description = Use Ryazhahand theme colors (theme.ini) for this mode's text.
;;User_UseTheme_Description_RU-RU = Использовать цвета темы Ryazhahand (theme.ini) для текста этого режима.
;;User_UseTheme_Name = Use theme colors
;;User_UseTheme_Name_RU-RU = Цвета из темы
;;User_UseTheme_DefaultValue = true
User_ShowTargetFrequencies = true
;;User_ShowTargetFrequencies_Description = Show target frequencies for CPU, GPU and RAM.
;;User_ShowTargetFrequencies_Description_PL-PL = Pokaż docelowe taktowanie CPU, GPU\ni RAM.
;;User_ShowTargetFrequencies_Description_DE-DE = Zeigt Zielfrequenzen für CPU, GPU und RAM an.
;;User_ShowTargetFrequencies_Description_RU-RU = Показывать целевые частоты CPU, GPU и RAM.
;;User_ShowTargetFrequencies_Name = Show target frequencies
;;User_ShowTargetFrequencies_Name_PL-PL = Pokaż docelowe częstowliości
;;User_ShowTargetFrequencies_Name_DE-DE = Zielfrequenzen anzeigen
;;User_ShowTargetFrequencies_Name_RU-RU = Показывать целевые частоты

;;User_ShowTargetFrequencies_DefaultValue = true
User_ShowFrequenceDeltas = true
;;User_ShowFrequenceDeltas_Description = Show difference between real frequency and target frequency. Shows up only when hoc-clk or sys-clk is detected running.
;;User_ShowFrequenceDeltas_Description_PL-PL = Pokaż różnicę między rzeczywistymi a docelowymi taktowaniami. Dostępne tylko gdy działa w tle hoc-clk albo sys-clk.
;;User_ShowFrequenceDeltas_Description_DE-DE = Zeigt Unterschied zwischen tatsächlicher und Zielfrequenz an. Wird nur angezeigt, wenn hoc-clk oder sys-clk erkannt werden.
;;User_ShowFrequenceDeltas_Description_RU-RU = Показывать разницу между реальной и целевой частотой. Отображается только при запущенном hoc-clk или sys-clk.

;;User_ShowFrequenceDeltas_Name = Show frequency deltas
;;User_ShowFrequenceDeltas_Name_PL-PL = Pokaż delty częstotliwości
;;User_ShowFrequenceDeltas_Name_DE-DE = Frequenzdifferenz anzeigen
;;User_ShowFrequenceDeltas_Name_RU-RU = Показывать дельты частот
;;User_ShowFrequenceDeltas_DefaultValue = true
User_ShowFPS = true
;;User_ShowFPS_Description = Shows FPS value when game runs. Shows up only when SaltyNX is detected running.
;;User_ShowFPS_Description_PL-PL = Pokaż FPS gdy gra jest uruchomiona. Dostępne tylko gdy SaltyNX działa w tle.
;;User_ShowFPS_Description_DE-DE = Zeigt die FPS-Anzahl in Spielen an. Wird nur angezeigt, wenn SaltyNX erkannt wurde.
;;User_ShowFPS_Description_RU-RU = Показывает FPS, когда запущена игра. Отображается только при запущенном SaltyNX.
;;User_ShowFPS_Name = Show FPS
;;User_ShowFPS_Name_PL-PL = Pokaż FPS
;;User_ShowFPS_Name_DE-DE = FPS anzeigen
;;User_ShowFPS_Name_RU-RU = Показывать FPS
;;User_ShowFPS_DefaultValue = true
User_ShowResolution = true
;;User_ShowResolution_Description = Shows two most likely candidates for rendering resolution of currently running game. Shows up only when SaltyNX is detected running.
;;User_ShowResolution_Description_PL-PL = Pokaż dwóch najlepszych kandydatów na rodzielczość renderowania gry. Dostępne tylko gdy SaltyNX działa w tle.
;;User_ShowResolution_Description_DE-DE = Zeigt die zwei wahrscheinlichsten Kandidaten für die Renderauflösung des aktuellen Spiels an. Wird nur angezeigt, wenn SaltyNX erkannt wurde.
;;User_ShowResolution_Description_RU-RU = Показывает два наиболее вероятных разрешения рендеринга текущей игры. Отображается только при запущенном SaltyNX.
;;User_ShowResolution_Name = Show resolutions
;;User_ShowResolution_Name_PL-PL = Pokaż rozdzielczości
;;User_ShowResolution_Name_DE-DE = Auflösungen anzeigen
;;User_ShowResolution_Name_RU-RU = Показывать разрешения
;;User_ShowResolution_DefaultValue = true
User_ShowReadSpeed = true
;;User_ShowReadSpeed_Description = Shows game's read speed in MiB/s. Shows up only when SaltyNX is detected running.
;;User_ShowReadSpeed_Description_PL-PL = Pokaż prędkość odczytu gry w MiB/s. Dostępne tylko gdy SaltyNX działa w tle.
;;User_ShowReadSpeed_Description_DE-DE = Zeigt die Lesegeschwindigkeit des Spiels in MiB/s an. Wird nur angezeigt, wenn SaltyNX erkannt wurde.
;;User_ShowReadSpeed_Description_RU-RU = Скорость чтения игры в МиБ/с. Отображается только при запущенном SaltyNX.
;;User_ShowReadSpeed_Name = Show game's read speed
;;User_ShowReadSpeed_Name_PL-PL = Pokaż prędkość odczytu
;;User_ShowReadSpeed_Name_DE-DE = Lese­geschwindigkeit anzeigen
;;User_ShowReadSpeed_Name_RU-RU = Показывать скорость чтения игры
;;User_ShowReadSpeed_DefaultValue = true
User_OldFPSAverage = false
;;User_OldFPSAverage_Description = Don't clamp FPS if they are in close range of PFPS value.
;;User_OldFPSAverage_Description_PL-PL = Nie zaokrąglaj FPS jeśli jest w pobliżu wartości PFPS.
;;User_OldFPSAverage_Description_DE-DE = Begrenze die FPS nicht, wenn sie sich in einem engen Bereich des PFPS-Wertes befinden.
;;User_OldFPSAverage_Description_RU-RU = Не округлять FPS, если значение близко к PFPS.
;;User_OldFPSAverage_Name = Use old FPS averaging
;;User_OldFPSAverage_Name_PL-PL = Użyj starego uśredniania FPS
;;User_OldFPSAverage_Name_DE-DE = Alte FPS-Mittelung verwenden
;;User_OldFPSAverage_Name_RU-RU = Старое усреднение FPS
;;User_OldFPSAverage_DefaultValue = false

ComboButtonFormat = IETF{"Hold %s to Exit"}
IETF_LOCALE{ComboButtonFormat, "PL-PL", "Przytrzymaj %s by wyjść"}
IETF_LOCALE{ComboButtonFormat, "DE-DE", "Halte %s zum Beenden"}
ComboButtonFooter = {IETF_GET{ComboButtonFormat}, formattedKeyCombo}

UseCustomExitCombo = true
EnableControls = false

TargetFreqTextFormat      = IETF{"Target Frequency: %u.%u MHz"}
RealFreqTextFormat        = IETF{"Real Frequency: %u.%u MHz"}
CPULoadTextFormat         = IETF{"Core #0: %.2lf%%\nCore #1: %.2lf%%\nCore #2: %.2lf%%\nCore #3: %.2lf%%"}
GPULoadTextFormat         = IETF{"Load: %u.%u%%"}
RAMLoadTextFormat         = IETF{"Load: %u.%u%% (CPU %u.%u | GPU %u.%u)"}
RAMUsageBaseTextFormat    = IETF{"Total: \nApplication: \nApplet: \nSystem: \nSystem Unsafe: "}
BatteryChargingTextFormat = IETF{"Battery Power Flow: %+.2fW[%s]"}
FanRotationTextFormat     = IETF{"Fan Rotation Level: %2.1f%%"}
FPSNDText                 = IETF{"PFPS: n/d; FPS: n/d"}
ReadSpeedTextFormat       = IETF{"Read speed: %.2f MiB/s"}
ReadSpeedUnkTextFormat    = IETF{"Read speed: n/d"}
CpuUsageText              = IETF{"CPU Usage:"}
GpuUsageText              = IETF{"GPU Usage:"}
RamUsageText              = IETF{"RAM Usage:"}
BoardUsageText            = IETF{"Board:"}
TemperatureText           = IETF{"Temperatures:"}
ThermalSensorsText        = IETF{"SOC \nPCB \nSkin "}
GameText                  = IETF{"Game:"}
Resolutions1Text          = IETF{"Resolutions: %dx%d"}
Resolutions2Text          = IETF{"Resolutions: %dx%d || %dx%d"}

