; CPU works only if clkrst or pcv was correctly initialized, realCPU_Hz_int is always 0 when hoc:clk or sys:clk is not detected
EnableCPU = true
CPUTargetFreqText: {IETF_GET{TargetFreqTextFormat}, CPU_Hz_int / 1000000, (CPU_Hz_int / 100000) % 10}
CPURealFreqText: {IETF_GET{RealFreqTextFormat}, CPU_RealHz_int / 1000000, (CPU_RealHz_int / 100000) % 10}
CPUdeltaText: {"Δ %d.%u", (CPU_RealHz_int - CPU_Hz_int) / 1000000, abs((CPU_RealHz_int - CPU_Hz_int) / 100000) % 10}
CPUloadText: {IETF_GET{CPULoadTextFormat}, CPU_Core0Load_double, CPU_Core1Load_double, CPU_Core2Load_double, CPU_Core3Load_double}

; GPU works only if nv + "clkrst or pcv" was correctly initialized, realGPU_Hz_int is always 0 when hoc:clk or sys:clk is not detected
EnableGPU = true
GPUTargetFreqText: {IETF_GET{TargetFreqTextFormat}, GPU_Hz_int / 1000000, (GPU_Hz_int / 100000) % 10}
GPURealFreqText: {IETF_GET{RealFreqTextFormat}, GPU_RealHz_int / 1000000, (GPU_RealHz_int / 100000) % 10}
GPUdeltaText: {"Δ %d.%u", (GPU_RealHz_int - GPU_Hz_int) / 1000000, abs((GPU_RealHz_int - GPU_Hz_int) / 100000) % 10}
GPUloadText: {IETF_GET{GPULoadTextFormat}, GPU_Load_int / 10, GPU_Load_int % 10}

; RAM works only if clkrst or pcv was correctly initialized + sysmodule correctly reports that SVC 0x6F is available
; loadRAM_All_int, LoadRAM_CPU_int are always 0 when hoc:clk or sys:clk is not detected
EnableRAM = true
RAMTargetFreqText: {IETF_GET{TargetFreqTextFormat}, RAM_Hz_int / 1000000, (RAM_Hz_int / 100000) % 10}
RAMRealFreqText: {IETF_GET{RealFreqTextFormat}, RAM_RealHz_int / 1000000, (RAM_RealHz_int / 100000) % 10}
RAMdeltaText: {"Δ %d.%u", (RAM_RealHz_int - RAM_Hz_int) / 1000000, abs((RAM_RealHz_int - RAM_Hz_int) / 100000) % 10}
RAMloadText: {IETF_GET{RAMLoadTextFormat}, RAM_LoadAll_int / 10, RAM_LoadAll_int % 10, RAM_LoadCPU_int / 10, RAM_LoadCPU_int % 10, (RAM_LoadAll_int - RAM_LoadCPU_int) / 10, (RAM_LoadAll_int - RAM_LoadCPU_int) % 10}
RAMusageBaseText = IETF_GET{RAMUsageBaseTextFormat}
RAMusageText: {"%4.2f / %4.2f MB\n%4.2f / %4.2f MB\n%4.2f / %4.2f MB\n%4.2f / %4.2f MB\n%4.2f / %4.2f MB", RAM_UsedAllMB_float, RAM_TotalAllMB_float, RAM_UsedApplicationMB_float, RAM_TotalApplicationMB_float, RAM_UsedAppletMB_float, RAM_TotalAppletMB_float, RAM_UsedSystemMB_float, RAM_TotalSystemMB_float, RAM_UsedSystemUnsafeMB_float, RAM_TotalSystemUnsafeMB_float}

; Board works only if at least one from i2c, tc, pwm was correctly initialized
EnableBoard = true
BatteryChargingText: {IETF_GET{BatteryChargingTextFormat}, Board_PowerConsumption_float, {Board_BatteryTimeEstimateInMinutes_int >= 0 ? {"%d:%02d", Board_BatteryTimeEstimateInMinutes_int / 60, Board_BatteryTimeEstimateInMinutes_int % 60} : "-:--"}}
TemperatureText: {"%2.1f°C\n%2.1f°C\n%d.%d°C", Board_SocTemperatureCelsius_float, Board_PcbTemperatureCelsius_float, Board_SkinTemperatureMiliCelsius_int / 1000, (Board_SkinTemperatureMiliCelsius_int / 100) % 10}
RotationText: {IETF_GET{FanRotationTextFormat}, Board_FanRotationPercentageLevel_float}

;Game works only if SaltyNX was correctly initialized
EnableGame = true
FPSText: {"PFPS: %u; FPS: %2.1f", Game_FPS_int, User_OldFPSAverage ? Game_FpsAvgOld_float : Game_FpsAvg_float}
FPSNoDataText = IETF_GET{FPSNDText}
ReadSpeedText: {IETF_GET{ReadSpeedTextFormat}, Game_ReadSpeedPerSecond_float / 1048576}
ReadSpeedUnkText = IETF_GET{ReadSpeedUnkTextFormat}

EnableBenchmark = false
;FrameTimeAverage = HISTORY{int, 10}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
ClockBatteryFormat: {"%02d:%02d   %.0f%%", System_ClockHour_int, System_ClockMinute_int, Board_BatteryChargePercentage_float}

Start:
; Ryazha theming: colors follow /config/ryazhahand/theme.ini when enabled.
#if $User_UseTheme
	VAR{CatColor, Theme_CategoryColor_int}
	VAR{TxtColor, Theme_TextColor_int}
#else
	VAR{CatColor, color(0xCCCF)}
	VAR{TxtColor, color(0xFFFF)}
#endif
#if $User_ShowClock
	VAR{ClockText, ClockBatteryFormat}
	GET_DIMENSIONS{ClockDims, 18, false, ClockText}
	TEXT{LayerWidth - ClockDims.x - 20, 120, 18, CatColor, false, ClockText}
#endif
#if $EnableBenchmark
	HISTORY_UPDATE{FrameTimeAverage, System_OverlayRenderingFrameTimeInNs_int}
	VAR{Average, HISTORY_AVERAGE{FrameTimeAverage}}
	TEXT{240, 120, 20, COLOR{0xCCCF}, true, {"MS: %d.%03d", Average / 1000000, (Average / 1000) % 1000}}
#endif
;CPU
#if $EnableCPU
	TEXT{0, 120, 20, CatColor, false, IETF_GET{CpuUsageText}}
	VAR{height_offset, 155}

	#if $User_ShowTargetFrequencies
		TEXT{0, height_offset, 15, TxtColor, false, CPUTargetFreqText}
		GET_DIMENSIONS{TargetDims, 15, false, CPUTargetFreqText}
	#endif

	#if $CPU_RealHz_int and $User_ShowRealFrequencies
		VAR{height_offset, height_offset + TargetDims.y}
		TEXT{0, height_offset, 15, TxtColor, false, CPURealFreqText}
		GET_DIMENSIONS{RealDims, 15, false, CPURealFreqText}
	#endif

	VAR{DeltaOffset, TargetDims.x > RealDims.x ? TargetDims.x : RealDims.x}

	#if $User_ShowFrequenceDeltas and $CPU_RealHz_int
		#if $User_ShowRealFrequencies and $User_ShowTargetFrequencies
			VAR{delta_offset, height_offset - (TargetDims.y / 2)}
		#else
			VAR{delta_offset, height_offset}
		#endif
		TEXT{DeltaOffset + 20, delta_offset, 15, TxtColor, false, CPUdeltaText}
	#endif

	TEXT{0, 200, 15, TxtColor, false, CPUloadText}
#endif

;GPU
#if $EnableGPU
	VAR{height_offset, 310}
	TEXT{0, 285, 20, CatColor, false, IETF_GET{GpuUsageText}}
	#if $User_ShowTargetFrequencies
		TEXT{0, height_offset, 15, TxtColor, false, GPUTargetFreqText}
		GET_DIMENSIONS{TargetDims, 15, false, GPUTargetFreqText}
	#endif

	#if $GPU_RealHz_int and $User_ShowRealFrequencies
		VAR{height_offset, height_offset + TargetDims.y}
		TEXT{0, height_offset, 15, TxtColor, false, GPURealFreqText}
		GET_DIMENSIONS{RealDims, 15, false, GPURealFreqText}
	#endif

	VAR{DeltaOffset, TargetDims.x > RealDims.x ? TargetDims.x : RealDims.x}

	#if $User_ShowFrequenceDeltas and $GPU_RealHz_int
		#if $User_ShowRealFrequencies and $User_ShowTargetFrequencies
			VAR{delta_offset, height_offset - (TargetDims.y / 2)}
			VAR{height_offset, height_offset + RealDims.y}
		#elif $User_ShowRealFrequencies or $User_ShowTargetFrequencies
			VAR{delta_offset, height_offset}
			#if $User_ShowRealFrequencies
				VAR{height_offset, height_offset + RealDims.y}
			#else
				VAR{height_offset, height_offset + TargetDims.y}
			#endif
		#else
			VAR{delta_offset, height_offset}
			GET_DIMENSIONS{dimensions, 15, false, "Ą"}
			VAR{height_offset, height_offset + dimensions.y}
		#endif
		TEXT{DeltaOffset + 20, delta_offset, 15, TxtColor, false, GPUdeltaText}
	#else
		#if $User_ShowRealFrequencies and $GPU_RealHz_int
			VAR{height_offset, height_offset + RealDims.y}
		#elif $User_ShowTargetFrequencies
			VAR{height_offset, height_offset + TargetDims.y}
		#else
			GET_DIMENSIONS{dimensions, 15, false, "Ą"}
			VAR{height_offset, height_offset + dimensions.y}
		#endif
	#endif

	TEXT{0, height_offset, 15, TxtColor, false, GPUloadText}
	GET_DIMENSIONS{Dims, 15, false, GPUloadText}
	VAR{height_offset, height_offset + Dims.y}
#endif

;RAM
#if $EnableRAM

	#if $height_offset < 375
		VAR{height_offset, 375}
	#endif

	TEXT{0, height_offset, 20, CatColor, false, IETF_GET{RamUsageText}}

	VAR{height_offset, 400}
	#if $User_ShowTargetFrequencies
		TEXT{0, height_offset, 15, TxtColor, false, RAMTargetFreqText}
		GET_DIMENSIONS{TargetDims, 15, false, RAMTargetFreqText}
	#endif

	#if $CPU_RealHz_int and $User_ShowRealFrequencies
		VAR{height_offset, height_offset + TargetDims.y}
		TEXT{0, height_offset, 15, TxtColor, false, RAMRealFreqText}
		GET_DIMENSIONS{RealDims, 15, false, RAMRealFreqText}
	#endif

	VAR{DeltaOffset, TargetDims.x > RealDims.x ? TargetDims.x : RealDims.x}

	#if $User_ShowFrequenceDeltas and $RAM_RealHz_int
		#if $User_ShowRealFrequencies and $User_ShowTargetFrequencies
			VAR{delta_offset, height_offset - (TargetDims.y / 2)}
			VAR{height_offset, height_offset + RealDims.y}
		#elif $User_ShowRealFrequencies or $User_ShowTargetFrequencies
			VAR{delta_offset, height_offset}
			#if $User_ShowRealFrequencies
				VAR{height_offset, height_offset + RealDims.y}
			#else
				VAR{height_offset, height_offset + TargetDims.y}
			#endif
		#else
			VAR{delta_offset, height_offset}
			GET_DIMENSIONS{dimensions, 15, false, "Ą"}
			VAR{height_offset, height_offset + dimensions.y}
		#endif
		TEXT{DeltaOffset + 20, delta_offset, 15, TxtColor, false, RAMdeltaText}
	#else
		#if $User_ShowRealFrequencies
			VAR{height_offset, height_offset + RealDims.y}
		#else
			VAR{height_offset, height_offset + TargetDims.y}
		#endif
	#endif

	#if $RAM_LoadAll_int
		TEXT{0, height_offset, 15, TxtColor, false, RAMloadText}
		GET_DIMENSIONS{dimensions, 15, false, RAMloadText}
		VAR{height_offset, height_offset + dimensions.y}
	#endif

	#if height_offset < 460
		VAR{height_offset, 460}
	#endif

	GET_DIMENSIONS{dimensions, 15, false, RAMusageBaseText}
	TEXT{0, height_offset, 15, TxtColor, false, RAMusageBaseText}
	TEXT{dimensions.x, height_offset, 15, TxtColor, false, RAMusageText}
#endif

;Board
#if $EnableBoard
	TEXT{0, 550, 20, CatColor, false, IETF_GET{BoardUsageText}}
	VAR{height_offset, 570}
	TEXT{0, height_offset, 15, TxtColor, false, BatteryChargingText}
	GET_DIMENSIONS{dimensions, 15, false, BatteryChargingText}
	VAR{height_offset, height_offset + dimensions.y}
	VAR{TemperText, IETF_GET{TemperatureText}}
	VAR{SensorsText, IETF_GET{ThermalSensorsText}}
	GET_DIMENSIONS{dimensions1, 15, false, TemperText}
	GET_DIMENSIONS{dimensions2, 15, false, SensorsText}
	TEXT{0, height_offset, 15, TxtColor, false, TemperText}
	TEXT{dimensions1.x, height_offset, 15, TxtColor, false, SensorsText}
	TEXT{dimensions1.x + dimensions2.x, height_offset, 15, TxtColor, false, TemperatureText}
	GET_DIMENSIONS{dimensions, 15, false, SensorsText}
	VAR{height_offset, height_offset + dimensions.y}
	TEXT{0, height_offset, 15, TxtColor, false, RotationText}
#endif

#if $EnableGame
	#if $Game_IsGameRunning
		VAR{width_offset, 150}
		#if $User_ShowFPS or $User_ShowResolution or $User_ShowReadSpeed
			TEXT{width_offset, 200, 20, CatColor, false, IETF_GET{GameText}}
		#endif
		VAR{height_offset, 225}
		#if $User_ShowFPS
			TEXT{width_offset, height_offset, 15, TxtColor, false, FPSText}
			GET_DIMENSIONS{dimensions, 15, false, FPSText}
			VAR{height_offset, height_offset + dimensions.y}
		#endif
		#if $User_ShowResolution and $Game_ResolutionRenderCalls_int[0].calls != 0xFFFF
			#if $Game_ResolutionRenderCalls_int[0].calls > $Game_ResolutionViewportCalls_int[0].calls
				VAR{resolutionOutput0, Game_ResolutionRenderCalls_int[0]}
				#if $Game_ResolutionRenderCalls_int[1].calls > $Game_ResolutionViewportCalls_int[0].calls
					VAR{resolutionOutput1, Game_ResolutionRenderCalls_int[1]}
				#else
					VAR{resolutionOutput1, Game_ResolutionViewportCalls_int[1]}
				#endif
			#else
				VAR{resolutionOutput0, Game_ResolutionViewportCalls_int[0]}
				#if $Game_ResolutionViewportCalls_int[1].calls < $Game_ResolutionRenderCalls_int[0].calls
					VAR{resolutionOutput1, Game_ResolutionRenderCalls_int[1]}
				#else
					VAR{resolutionOutput1, Game_ResolutionViewportCalls_int[1]}
				#endif
			#endif
			VAR{ResolutionsText, {IETF_GET{Resolutions1Text}, resolutionOutput0.width, resolutionOutput0.height}}
			VAR{ResolutionsBackText, {IETF_GET{Resolutions1Text}, resolutionOutput1.width, resolutionOutput1.height}}
			VAR{ResolutionsTwoText, {IETF_GET{Resolutions2Text}, resolutionOutput0.width, resolutionOutput0.height, resolutionOutput1.width, resolutionOutput1.height}}
			#if $resolutionOutput0.width == 0 or $resolutionOutput1.width == 0
				#if $resolutionOutput0.width > 0
					TEXT{width_offset, height_offset, 15, TxtColor, false, ResolutionsText}
				#else
					TEXT{width_offset, height_offset, 15, TxtColor, false, ResolutionsBackText}
				#endif
			#endif
			#if $resolutionOutput0.width > 0 and $resolutionOutput1.width > 0
				TEXT{width_offset, height_offset, 15, TxtColor, false, ResolutionsTwoText}
			#endif
			GET_DIMENSIONS{Dimensions, 15, false, "Ą"}
			VAR{height_offset, height_offset + Dimensions.y}
		#endif
		#if $User_ShowReadSpeed
			#if $Game_ReadSpeedPerSecond_float
				TEXT{width_offset, height_offset, 15, TxtColor, false, ReadSpeedText}
			#else
				TEXT{width_offset, height_offset, 15, TxtColor, false, ReadSpeedUnkText}
			#endif
		#endif
	#endif
#endif

