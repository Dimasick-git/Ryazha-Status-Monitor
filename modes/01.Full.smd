DashboardTitleText = IETF{"SYSTEM STATUS"}
ThermalTextFormat = IETF{"SOC %.1f°C | PCB %.1f°C\nSkin %d.%d°C | Fan %.0f%%"}
FPSTextFormat = IETF{"PFPS %u | FPS %.1f"}
GameInactiveText = IETF{"No game is running"}
IETF_LOCALE{DashboardTitleText, "PL-PL", "STATUS SYSTEMU"}
IETF_LOCALE{ThermalTextFormat, "PL-PL", "SOC %.1f°C | PCB %.1f°C\nObudowa %d.%d°C | Wentylator %.0f%%"}
IETF_LOCALE{FPSTextFormat, "PL-PL", "PFPS %u | FPS %.1f"}
IETF_LOCALE{GameInactiveText, "PL-PL", "Gra nie jest uruchomiona"}
IETF_LOCALE{DashboardTitleText, "DE-DE", "SYSTEMSTATUS"}
IETF_LOCALE{ThermalTextFormat, "DE-DE", "SOC %.1f°C | PCB %.1f°C\nGehäuse %d.%d°C | Lüfter %.0f%%"}
IETF_LOCALE{FPSTextFormat, "DE-DE", "PFPS %u | FPS %.1f"}
IETF_LOCALE{GameInactiveText, "DE-DE", "Kein Spiel aktiv"}
IETF_LOCALE{DashboardTitleText, "RU-RU", "СТАТУС СИСТЕМЫ"}
IETF_LOCALE{ThermalTextFormat, "RU-RU", "SOC %.1f°C | PCB %.1f°C\nКорпус %d.%d°C | Вентилятор %.0f%%"}
IETF_LOCALE{FPSTextFormat, "RU-RU", "PFPS %u | FPS %.1f"}
IETF_LOCALE{GameInactiveText, "RU-RU", "Игра не запущена"}

; Full dashboard — compact Switch 2 Style card layout.
; Coordinates are relative to COMMON_MARGIN and leave space for header and custom footer.

EnableCPU = true
CPUTargetFreqText: {IETF_GET{TargetFreqTextFormat}, CPU_Hz_int / 1000000, (CPU_Hz_int / 100000) % 10}
CPURealFreqText: {IETF_GET{RealFreqTextFormat}, CPU_RealHz_int / 1000000, (CPU_RealHz_int / 100000) % 10}
CPUdeltaText: {"Δ %d.%u", (CPU_RealHz_int - CPU_Hz_int) / 1000000, abs((CPU_RealHz_int - CPU_Hz_int) / 100000) % 10}
CPUloadText: {IETF_GET{CPULoadTextFormat}, CPU_Core0Load_double, CPU_Core1Load_double, CPU_Core2Load_double, CPU_Core3Load_double}

EnableGPU = true
GPUTargetFreqText: {IETF_GET{TargetFreqTextFormat}, GPU_Hz_int / 1000000, (GPU_Hz_int / 100000) % 10}
GPURealFreqText: {IETF_GET{RealFreqTextFormat}, GPU_RealHz_int / 1000000, (GPU_RealHz_int / 100000) % 10}
GPUdeltaText: {"Δ %d.%u", (GPU_RealHz_int - GPU_Hz_int) / 1000000, abs((GPU_RealHz_int - GPU_Hz_int) / 100000) % 10}
GPUloadText: {IETF_GET{GPULoadTextFormat}, GPU_Load_int / 10, GPU_Load_int % 10}

EnableRAM = true
RAMTargetFreqText: {IETF_GET{TargetFreqTextFormat}, RAM_Hz_int / 1000000, (RAM_Hz_int / 100000) % 10}
RAMRealFreqText: {IETF_GET{RealFreqTextFormat}, RAM_RealHz_int / 1000000, (RAM_RealHz_int / 100000) % 10}
RAMdeltaText: {"Δ %d.%u", (RAM_RealHz_int - RAM_Hz_int) / 1000000, abs((RAM_RealHz_int - RAM_Hz_int) / 100000) % 10}
RAMloadText: {IETF_GET{RAMLoadTextFormat}, RAM_LoadAll_int / 10, RAM_LoadAll_int % 10, RAM_LoadCPU_int / 10, RAM_LoadCPU_int % 10, (RAM_LoadAll_int - RAM_LoadCPU_int) / 10, (RAM_LoadAll_int - RAM_LoadCPU_int) % 10}
RAMusageText: {"App %.0f/%.0f MB\nSys %.0f/%.0f MB", RAM_UsedApplicationMB_float, RAM_TotalApplicationMB_float, RAM_UsedSystemMB_float, RAM_TotalSystemMB_float}

EnableBoard = true
BatteryChargingText: {IETF_GET{BatteryChargingTextFormat}, Board_PowerConsumption_float, {Board_BatteryTimeEstimateInMinutes_int >= 0 ? {"%d:%02d", Board_BatteryTimeEstimateInMinutes_int / 60, Board_BatteryTimeEstimateInMinutes_int % 60} : "-:--"}}
ThermalText: {IETF_GET{ThermalTextFormat}, Board_SocTemperatureCelsius_float, Board_PcbTemperatureCelsius_float, Board_SkinTemperatureMiliCelsius_int / 1000, (Board_SkinTemperatureMiliCelsius_int / 100) % 10, Board_FanRotationPercentageLevel_float}

EnableGame = true
FPSText: {IETF_GET{FPSTextFormat}, Game_FPS_int, User_OldFPSAverage ? Game_FpsAvgOld_float : Game_FpsAvg_float}
FPSNoDataText = IETF_GET{FPSNDText}
ReadSpeedText: {IETF_GET{ReadSpeedTextFormat}, Game_ReadSpeedPerSecond_float / 1048576}
ReadSpeedUnkText = IETF_GET{ReadSpeedUnkTextFormat}

ClockBatteryFormat: {"%02d:%02d   %.0f%%", System_ClockHour_int, System_ClockMinute_int, Board_BatteryChargePercentage_float}
DashboardTitle = IETF_GET{DashboardTitleText}

Start:
	#if $User_UseTheme
		VAR{CatColor, Theme_CategoryColor_int}
		VAR{TxtColor, Theme_TextColor_int}
		VAR{AccColor, Theme_AccentColor_int}
	#else
		VAR{CatColor, color(0xCCCF)}
		VAR{TxtColor, color(0xFFFF)}
		VAR{AccColor, color(0x8DEF)}
	#endif
	VAR{CardColor, color(0x202F)}
	VAR{BarTrack, color(0x333F)}
	VAR{LeftCardX, 0}
	VAR{RightCardX, 210}
	VAR{CardWidth, 190}
	VAR{InnerWidth, 162}

	TEXT{0, 116, 14, CatColor, false, DashboardTitle}
	#if $User_ShowClock
		VAR{ClockText, ClockBatteryFormat}
		GET_DIMENSIONS{ClockDims, 14, false, ClockText}
		TEXT{400 - ClockDims.x, 116, 14, CatColor, false, ClockText}
	#endif

	; CPU card
	ROUNDED_BOX{LeftCardX, 140, CardWidth, 145, 12, 12, 12, 12, CardColor}
	#if $EnableCPU
		TEXT{LeftCardX + 14, 156, 16, CatColor, false, IETF_GET{CpuUsageText}}
		#if $User_ShowTargetFrequencies
			TEXT{LeftCardX + 14, 184, 12, TxtColor, false, CPUTargetFreqText}
		#endif
		#if $User_ShowRealFrequencies and $CPU_RealHz_int
			TEXT{LeftCardX + 14, 202, 12, TxtColor, false, CPURealFreqText}
		#endif
		#if $User_ShowFrequenceDeltas and $CPU_RealHz_int
			TEXT{LeftCardX + 14, 220, 12, AccColor, false, CPUdeltaText}
		#endif
		TEXT{LeftCardX + 14, 238, 12, TxtColor, false, CPUloadText}
		#if $User_ShowLoadBars
			VAR{CpuAvg, (CPU_Core0Load_double + CPU_Core1Load_double + CPU_Core2Load_double + CPU_Core3Load_double) / 4}
			BOX{LeftCardX + 14, 272, InnerWidth, 4, BarTrack}
			BOX{LeftCardX + 14, 272, CpuAvg * 1.62, 4, AccColor}
		#endif
	#endif

	; GPU card
	ROUNDED_BOX{RightCardX, 140, CardWidth, 145, 12, 12, 12, 12, CardColor}
	#if $EnableGPU
		TEXT{RightCardX + 14, 156, 16, CatColor, false, IETF_GET{GpuUsageText}}
		#if $User_ShowTargetFrequencies
			TEXT{RightCardX + 14, 184, 12, TxtColor, false, GPUTargetFreqText}
		#endif
		#if $User_ShowRealFrequencies and $GPU_RealHz_int
			TEXT{RightCardX + 14, 202, 12, TxtColor, false, GPURealFreqText}
		#endif
		#if $User_ShowFrequenceDeltas and $GPU_RealHz_int
			TEXT{RightCardX + 14, 220, 12, AccColor, false, GPUdeltaText}
		#endif
		TEXT{RightCardX + 14, 238, 12, TxtColor, false, GPUloadText}
		#if $User_ShowLoadBars
			BOX{RightCardX + 14, 272, InnerWidth, 4, BarTrack}
			BOX{RightCardX + 14, 272, GPU_Load_int * 0.162, 4, AccColor}
		#endif
	#endif

	; RAM card
	ROUNDED_BOX{LeftCardX, 300, CardWidth, 160, 12, 12, 12, 12, CardColor}
	#if $EnableRAM
		TEXT{LeftCardX + 14, 316, 16, CatColor, false, IETF_GET{RamUsageText}}
		#if $User_ShowTargetFrequencies
			TEXT{LeftCardX + 14, 342, 12, TxtColor, false, RAMTargetFreqText}
		#endif
		#if $User_ShowRealFrequencies and $RAM_RealHz_int
			TEXT{LeftCardX + 14, 360, 12, TxtColor, false, RAMRealFreqText}
		#endif
		#if $User_ShowFrequenceDeltas and $RAM_RealHz_int
			TEXT{LeftCardX + 14, 378, 12, AccColor, false, RAMdeltaText}
		#endif
		#if $RAM_LoadAll_int
			TEXT{LeftCardX + 14, 396, 12, TxtColor, false, RAMloadText}
			#if $User_ShowLoadBars
				BOX{LeftCardX + 14, 414, InnerWidth, 4, BarTrack}
				BOX{LeftCardX + 14, 414, RAM_LoadAll_int * 0.162, 4, AccColor}
			#endif
		#endif
		TEXT{LeftCardX + 14, 430, 12, TxtColor, false, RAMusageText}
	#endif

	; Game card
	ROUNDED_BOX{RightCardX, 300, CardWidth, 160, 12, 12, 12, 12, CardColor}
	#if $EnableGame
		TEXT{RightCardX + 14, 316, 16, CatColor, false, IETF_GET{GameText}}
		#if $Game_IsGameRunning
			#if $User_ShowFPS
				TEXT{RightCardX + 14, 346, 12, TxtColor, false, FPSText}
			#endif
			#if $User_ShowResolution and $Game_ResolutionRenderCalls_int[0].calls != 0xFFFF
				#if $Game_ResolutionRenderCalls_int[0].calls > $Game_ResolutionViewportCalls_int[0].calls
					VAR{resolutionOutput0, Game_ResolutionRenderCalls_int[0]}
				#else
					VAR{resolutionOutput0, Game_ResolutionViewportCalls_int[0]}
				#endif
				#if $Game_ResolutionRenderCalls_int[1].calls > $Game_ResolutionViewportCalls_int[1].calls
					VAR{resolutionOutput1, Game_ResolutionRenderCalls_int[1]}
				#else
					VAR{resolutionOutput1, Game_ResolutionViewportCalls_int[1]}
				#endif
				#if $resolutionOutput0.width > 0 and $resolutionOutput1.width > 0
					TEXT{RightCardX + 14, 370, 12, TxtColor, false, {IETF_GET{Resolutions2Text}, resolutionOutput0.width, resolutionOutput0.height, resolutionOutput1.width, resolutionOutput1.height}}
				#else
					TEXT{RightCardX + 14, 370, 12, TxtColor, false, {IETF_GET{Resolutions1Text}, resolutionOutput0.width, resolutionOutput0.height}}
				#endif
			#endif
			#if $User_ShowReadSpeed
				#if $Game_ReadSpeedPerSecond_float
					TEXT{RightCardX + 14, 394, 12, TxtColor, false, ReadSpeedText}
				#else
					TEXT{RightCardX + 14, 394, 12, TxtColor, false, ReadSpeedUnkText}
				#endif
			#endif
		#else
			TEXT{RightCardX + 14, 350, 12, TxtColor, false, IETF_GET{GameInactiveText}}
		#endif
	#endif

	; Board and battery card
	ROUNDED_BOX{0, 475, 400, 170, 12, 12, 12, 12, CardColor}
	#if $EnableBoard
		TEXT{14, 491, 16, CatColor, false, IETF_GET{BoardUsageText}}
		TEXT{14, 523, 13, TxtColor, false, BatteryChargingText}
		TEXT{14, 553, 13, TxtColor, false, ThermalText}
		#if $Board_BatteryChargePercentage_float
			BOX{14, 614, 372, 5, BarTrack}
			BOX{14, 614, Board_BatteryChargePercentage_float * 3.72, 5, AccColor}
		#endif
	#endif

